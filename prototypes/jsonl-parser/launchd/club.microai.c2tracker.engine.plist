<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>club.microai.c2tracker.engine</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/OWC-taipm-ssd/gitea/C2-Tracker/prototypes/jsonl-parser/target/release/c2-engine</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/taipm/.c2-tracker/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/taipm/.c2-tracker/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/taipm</string>
</dict>
</plist>
