{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C2-Tracker",
  "version": "0.1.0",
  "identifier": "club.microai.c2tracker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "C2-Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Realtime recording cho Claude Code sessions",
    "longDescription": "C2-Tracker là desktop app theo dõi và lưu trữ mọi phiên làm việc với Claude Code, hiển thị realtime qua WebSocket."
  }
}
